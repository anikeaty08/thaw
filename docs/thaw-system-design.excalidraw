than rewards cover\n\nBoth: fixed 5–6% APR, repaid by\nThursday harvests, repay early anytime.", "textAlign": "left", "updated": 1792946701254, "version": 4, "versionNonce": 1547461910, "verticalAlign": "top"}, {"id": "z1a-label", "type": "text", "x": 1650, "y": 4192.5, "width": 280, "height": 45, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": "z1a", "fillStyle": "solid", "fontFamily": 1, "fontSize": 18, "frameId": null, "groupIds": [], "index": "a5", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Weekly income\n60 MUSD", "roughness": 1, "roundness": null, "seed": 1864134950, "strokeColor": "#1971c2", "strokeStyle": "solid", "strokeWidth": 1, "text": "Weekly income\n60 MUSD", "textAlign": "center", "updated": 1792946701254, "version": 3, "versionNonce": 967680446, "verticalAlign": "middle"}, {"id": "z1b-label", "type": "text", "x": 1650, "y": 4342.5, "width": 280, "height": 45, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": "z1b", "fillStyle": "solid", "fontFamily": 1, "fontSize": 18, "frameId": null, "groupIds": [], "index": "a7", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "× 75% counted\n= 45 MUSD", "roughness": 1, "roundness": null, "seed": 1623614613, "strokeColor": "#1971c2", "strokeStyle": "solid", "strokeWidth": 1, "text": "× 75% counted\n= 45 MUSD", "textAlign": "center", "updated": 1792946701254, "version": 3, "versionNonce": 381001441, "verticalAlign": "middle"}, {"id": "z1c-label", "type": "text", "x": 1650, "y": 4492.5, "width": 280, "height": 45, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": "z1c", "fillStyle": "solid", "fontFamily": 1, "fontSize": 18, "frameId": null, "groupIds": [], "index": "a9", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, 