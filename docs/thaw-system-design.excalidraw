9, "strokeColor": "#1971c2", "strokeStyle": "solid", "strokeWidth": 2, "text": "ADVANCE LOANS", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 1663344443, "verticalAlign": "top"}, {"id": "mvnuuy58fbhn5unlfs8", "type": "text", "x": 60, "y": 2690, "width": 326.51177978515625, "height": 100, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 16, "frameId": null, "groupIds": [], "index": "b0f", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Never liquidated on price. If rewards dip,\nthe loan just takes longer. Only after\n8 Thursdays with zero repayment AND a\nvalue-based health below 1 does an\nAdvance enter this flow.", "roughness": 1, "roundness": null, "seed": 938933033, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "Never liquidated on price. If rewards dip,\nthe loan just takes longer. Only after\n8 Thursdays with zero repayment AND a\nvalue-based health below 1 does an\nAdvance enter this flow.", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 1180976629, "verticalAlign": "top"}, {"id": "mvnuuy58yypoy9rsf0b", "type": "text", "x": 620, "y": 2770, "width": 510.3974609375, "height": 17.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 14, "frameId": null, "groupIds": [], "index": "b0g", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Today the reserve buyout is owner-only; Phase 2 hands it to the keeper.", "roughness": 1, "roundness": null, "seed": 627862686, "strokeColor": "#868e96", "strokeStyle": "solid", "strokeWidth": 2, "text": "Today the reserve buyout is owner-only; Phase 2 hands it to the keeper.", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 1969422299, "verticalAlign": "top"}, {"id": "mvnuvhqne15ueiyv16e", "type": "rectangle", "x": 1580, "y": 2000, "width": 1480, "height": 900, "angle": 0, "backgroundColor": "#f8f9fa", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0h", "isDeleted": false, "link": null, "locked": false, "opacity": 60, "roughness": 1, "roundness": {"type": 3}, "seed": 511597111, "strokeColor": "#ced4da", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 1177665365}, {"id": "mvnuvhqn6gcmkqwpx39", "type": "text", "x": 1620, "y": 2024, "width": 523.40380859375, "height": 35, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 28, "frameId": null, "groupIds": [], "index": "b0i", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "6 · Roadmap: what's live, what's next", "roughness": 1, "roundness": null, "seed": 187203602, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "6 · Roadmap: what's live, what's next", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 1045187707, "verticalAlign": "top"}, {"id": "mvnuvhqnwkde7zxasqe", "type": "text", "x": 1620, "y": 2064, "width": 940.5435791015625, "height": 20, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 16, "frameId": null, "groupIds": [], "index": "b0j", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "Phase 1 proves the loop on testnet. Phase 2 makes it real and safe. Phase 3 takes it to mainnet and beyond Thaw.", "roughness": 1, "roundness": null, "seed": 1336760924, "strokeColor": "#868e96", "strokeStyle": "solid", "strokeWidth": 2, "text": "Phase 1 proves the loop on testnet. Phase 2 makes it real and safe. Phase 3 takes it to mainnet and beyond Thaw.", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 1422462133, "verticalAlign": "top"}, {"id": "p1h", "type": "rectangle", "x": 1620, "y": 2120, "width": 440, "height": 70, "angle": 0, "backgroundColor": "#b2f2bb", "boundElements": [{"id": "p1h-label", "type": "text"}, {"id": "mvnuvhqnt28l7812uz9", "type": "arrow"}], "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0k", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 3}, "seed": 1662427796, "strokeColor": "#2f9e44", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 27460891}, {"id": "p2h", "type": "rectangle", "x": 2110, "y": 2120, "width": 440, "height": 70, "angle": 0, "backgroundColor": "#a5d8ff", "boundElements": [{"id": "p2h-label", "type": "text"}, {"id": "mvnuvhqnt28l7812uz9", "type": "arrow"}, {"id": "mvnuvhqnr5o0xosq40k", "type": "arrow"}], "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0l", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 3}, "seed": 471512911, "strokeColor": "#1971c2", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 567258645}, {"id": "p3h", "type": "rectangle", "x": 2600, "y": 2120, "width": 440, "height": 70, "angle": 0, "backgroundColor": "#eebefa", "boundElements": [{"id": "p3h-label", "type": "text"}, {"id": "mvnuvhqnr5o0xosq40k", "type": "arrow"}], "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0m", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 3}, "seed": 1581926796, "strokeColor": "#9c36b5", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 1725540795}, {"id": "mvnuvhqnbkb01lwlobq", "type": "rectangle", "x": 1620, "y": 2210, "width": 440, "height": 480, "angle": 0, "backgroundColor": "#ffffff", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0n", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 3}, "seed": 2076911297, "strokeColor": "#2f9e44", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 1278944117}, {"id": "mvnuvhqnmv11v2vj6ep", "type": "text", "x": 1645, "y": 2235, "width": 312.0838317871094, "height": 382.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 18, "frameId": null, "groupIds": [], "index": "b0o", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "✓ Advance + Credit Line loans\n\n✓ tMUSD vault (ERC-4626) with\n   instant + queued withdrawals\n\n✓ Thursday auto-harvest keeper\n\n✓ Dutch auction liquidator\n   + reserve fund backstop\n\n✓ Ponder indexer on AWS ECS,\n   per-wallet activity feed\n\n✓ Web app: wallet gate, Recent,\n   docs, 3D story, testnet faucet\n\n✓ Telegram bot: loans, quotes", "roughness": 1, "roundness": null, "seed": 1423638322, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "✓ Advance + Credit Line loans\n\n✓ tMUSD vault (ERC-4626) with\n   instant + queued withdrawals\n\n✓ Thursday auto-harvest keeper\n\n✓ Dutch auction liquidator\n   + reserve fund backstop\n\n✓ Ponder indexer on AWS ECS,\n   per-wallet activity feed\n\n✓ Web app: wallet gate, Recent,\n   docs, 3D story, testnet faucet\n\n✓ Telegram bot: loans, quotes", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 51559003, "verticalAlign": "top"}, {"id": "mvnuvhqnlvkwb91rda", "type": "rectangle", "x": 2110, "y": 2210, "width": 440, "height": 480, "angle": 0, "backgroundColor": "#ffffff", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0p", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 3}, "seed": 1051749209, "strokeColor": "#1971c2", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 2018569429}, {"id": "mvnuvhqny9rbku5udbs", "type": "text", "x": 2135, "y": 2235, "width": 324.89605712890625, "height": 405, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 18, "frameId": null, "groupIds": [], "index": "b0q", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "→ Real veMEZO & veBTC adapters\n   (live voter, router, oracles)\n\n→ External audit + bug bounty\n\n→ Keeper runs the reserve\n   buyout automatically\n\n→ WalletConnect + phone wallets\n\n→ Alerts: health, harvests, auctions\n   (Telegram + browser push)\n\n→ Compound mode: surplus\n   re-locks MEZO automatically\n\n→ Oracle hardening: TWAP fallback,\n   MUSD depeg circuit breaker", "roughness": 1, "roundness": null, "seed": 2109419987, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "→ Real veMEZO & veBTC adapters\n   (live voter, router, oracles)\n\n→ External audit + bug bounty\n\n→ Keeper runs the reserve\n   buyout automatically\n\n→ WalletConnect + phone wallets\n\n→ Alerts: health, harvests, auctions\n   (Telegram + browser push)\n\n→ Compound mode: surplus\n   re-locks MEZO automatically\n\n→ Oracle hardening: TWAP fallback,\n   MUSD depeg circuit breaker", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 589346555, "verticalAlign": "top"}, {"id": "mvnuvhqnwp738ql37sd", "type": "rectangle", "x": 2600, "y": 2210, "width": 440, "height": 480, "angle": 0, "backgroundColor": "#ffffff", "boundElements": null, "fillStyle": "solid", "frameId": null, "groupIds": [], "index": "b0r", "isDeleted": false, "link": null, "locked": false, "opacity": 100, "roughness": 1, "roundness": {"type": 3}, "seed": 1750283249, "strokeColor": "#9c36b5", "strokeStyle": "solid", "strokeWidth": 2, "updated": 1792946676165, "version": 3, "versionNonce": 631671349}, {"id": "mvnuvhqnax41w3c66yu", "type": "text", "x": 2625, "y": 2235, "width": 311.1080627441406, "height": 382.5, "angle": 0, "autoResize": true, "backgroundColor": "transparent", "boundElements": null, "containerId": null, "fillStyle": "solid", "fontFamily": 1, "fontSize": 18, "frameId": null, "groupIds": [], "index": "b0s", "isDeleted": false, "lineHeight": 1.25, "link": null, "locked": false, "opacity": 100, "originalText": "→ Mezo mainnet launch\n\n→ Sell liquidated locks on Mezo's\n   official veNFT marketplace\n\n→ tMUSD as collateral & LP\n   across Mezo DeFi\n\n→ Refinance & transfer loans\n   via the PositionNFT\n\n→ Senior / junior vault tranches\n\n→ Cross-chain borrowing (Base)\n\n→ Governance for risk parameters,\n   public risk dashboard", "roughness": 1, "roundness": null, "seed": 1526708585, "strokeColor": "#1e1e1e", "strokeStyle": "solid", "strokeWidth": 2, "text": "→ Mezo mainnet launch\n\n→ Sell liquidated locks on Mezo's\n   official veNFT marketplace\n\n→ tMUSD as collateral & LP\n   across Mezo DeFi\n\n→ Refinance & transfer loans\n   via the PositionNFT\n\n→ Senior / junior vault tranches\n\n→ Cross-chain borrowing (Base)\n\n→ Governance for risk parameters,\n   public risk dashboard", "textAlign": "left", "updated": 1792946676165, "version": 4, "versionNonce": 1434853275, "verticalAlign": "top"}, {"id": "mvnuvhqnt28l7812uz9", "type": "arrow", "x": 2068, "y": 2155, "width": 33, "height": 0, "angle": 0, "backgroundColor": "transparent", "boundElements": null, "elbowed": false, "endArrowhead": "arrow", "endBinding": {"elementId": "p2h", "fixedPoint": null, "focus": 0, "gap": 4}, "fillStyle": "solid", "frameId": null, "groupIds":