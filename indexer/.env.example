# Mezo testnet (docs/THAW_SYSTEM_DESIGN.md §6.1)
PONDER_RPC_URL_MEZO_TESTNET=https://rpc.test.mezo.org

# Deployed addresses (fill in after `forge script script/Deploy.s.sol --broadcast`)
LOAN_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
HARVESTER_ADDRESS=0x0000000000000000000000000000000000000000
TMUSD_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
DUTCH_AUCTION_LIQUIDATOR_ADDRESS=0x0000000000000000000000000000000000000000
STRATEGY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Block the LoanManager (and friends) were deployed at, so the indexer doesn't replay from genesis.
START_BLOCK=0

# Optional Postgres connection for `ponder start` in production (defaults to local SQLite for `ponder dev`).
DATABASE_URL=
