# From @BotFather (Track 2: Access & Distribution, docs/THAW_SYSTEM_DESIGN.md §13)
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

RPC_URL=https://rpc.test.mezo.org
CHAIN_ID=31611
LOAN_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
INDEXER_URL=http://localhost:42069

# The dApp URL the bot deep-links to for the one-tap repay flow (§13, §21.3 video script).
WEBAPP_URL=https://thaw.mezo.org

# Chat<->wallet links live in Postgres (same Supabase project the indexer uses works fine — a
# separate schema/table, no conflict). Required by src/store.ts in every run mode.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Only needed for the Vercel webhook deployment (api/webhook.ts + scripts/set-webhook.ts).
# Verifies a POST actually came from Telegram; any long random string works. Leave unset for local
# long-polling (src/index.ts), which doesn't receive webhook calls at all.
TELEGRAM_WEBHOOK_SECRET=

# Epoch report broadcast, right after the keeper's Thursday harvest window (§10.1: 00:05-06:00 UTC).
# In production this fires from .github/workflows/bot-notify.yml, not from this env var — it's read
# here only by the long-polling src/index.ts entrypoint (local dev / self-hosting).
EPOCH_REPORT_CRON=0 7 * * 4
