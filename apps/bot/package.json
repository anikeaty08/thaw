{
  "name": "@thaw/telegram-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "notify:epoch": "tsx src/notify.ts epoch",
    "notify:warnings": "tsx src/notify.ts warnings",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "delete-webhook": "tsx scripts/delete-webhook.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
